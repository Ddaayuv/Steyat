# توكن البوت من @BotFather
BOT_TOKEN=123456:ABC-your-token

# معرّفات المالك/المطوّر مفصولة بفاصلة. هؤلاء فقط لديهم لوحة المطوّر والإذاعة.
OWNER_IDS=111111111

# اسم الأكاديمية الذي يظهر للمستخدم
ACADEMY_NAME=أكاديمية الأمن السيبراني

# قاعدة البيانات: اختر واحداً فقط.
# SQLite: ضع مساراً داخل Railway Volume دائم مثل /app/data/bot.db
DB_PATH=data/bot.db
# PostgreSQL (اختياري): ضع DATABASE_URL من Railway Postgres؛ عند ضبطه يتقدم على DB_PATH.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# قناة الاشتراك/الإعلانات الابتدائية (يمكن تعديلها من /adminpanel)
CHANNEL_ID=
CHANNEL_LINK=
REQUIRE_MEMBERSHIP=false
ANNOUNCE=true

# النسخ الاحتياطي اليومي: Telegram ID المرسل إليه، والساعة حسب توقيت الخادم (Railway غالباً UTC)
BACKUP_CHAT_ID=
BACKUP_HOUR=3
